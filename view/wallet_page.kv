<WalletPage>
    theme_bg_color:"Custom"
    #md_bg_color:139/255,139/255,139/255,1
    spacing:dp(20)
    padding:dp(20)
    size_hint_y:None
    height:self.minimum_height
    MDBoxLayout:
        adaptive_height: True
        orientation:"vertical"
        spacing:dp(20)
        padding:dp(20)
        MDBoxLayout:
            size_hint_y: None
            height: dp(70)
            orientation: "vertical"
            spacing:dp(7)
            padding:dp(7)
            MDLabel:
                size_hint_y:0.05
                text:"filtrer par"
                font_style:"Title"
                role:"medium"
            MDBoxLayout:
                size_hint_y: None
                height: dp(70)
                spacing:dp(7)
                padding:dp(7)
                MDButton:
                    id:date_button
                    theme_bg_color:"Custom"
                    md_bg_color:171/255,219/255,227/255,1
                    radius:[15]
                    size_hint_y: None
                    on_release:
                        root.show_date_picker()
                    MDButtonText:
                        text:"Date"
                        theme_text_color:"Custom"
                        text_color:26/255, 58/255, 82/255, 1

                MDButton:
                    theme_bg_color:"Custom"
                    md_bg_color:171/255,219/255,227/255,1
                    radius:[15]
                    size_hint_y: None
                    on_release:
                        root.show_modal_date_picker()
                    MDButtonText:
                        text:"Période"
                        theme_text_color:"Custom"
                        text_color:26/255, 58/255, 82/255, 1

                MDButton:
                    theme_bg_color:"Custom"
                    md_bg_color:171/255,219/255,227/255,1
                    radius:[15]
                    size_hint_y: None
                    on_release:
                        root.show_month_picker()
                    MDButtonText:
                        text:"Mois"
                        theme_text_color:"Custom"
                        text_color:26/255, 58/255, 82/255, 1
                MDButton:
                    theme_bg_color:"Custom"
                    md_bg_color:171/255,219/255,227/255,1
                    radius:[15]
                    size_hint_y: None
                    on_release:
                        root.show_year_picker()
                    MDButtonText:
                        text:"Année"
                        theme_text_color:"Custom"
                        text_color:26/255, 58/255, 82/255, 1

        MDCard:
            size_hint_x:1
            size_hint_y:None
            height:dp(400)
            style: "elevated"
            elevation:10
            theme_bg_color:"Custom"
            md_bg_color:app.product_tab
            radius:[20]
            Historique:
                id:historique
                theme_bg_color:"Custom"
                md_bg_color:app.product_tab
                size_hint : 1,1
                on_parent:self.show_historique()
    MDBoxLayout:
        adaptive_height: True
        id:wallet_section_2
        orientation:"vertical"
        spacing:dp(20)
        padding:dp(20)
        size_hint_x:0.3
        MDCard:
            pos_hint: {"y": 0.8}
            size_hint_y:None
            height:dp(100)
            style: "elevated"
            elevation:10
            radius:[20]
            theme_bg_color:"Custom"
            md_bg_color:139/255,139/255,139/255,1
            BoxLayout:
                adaptive_height: True
                orientation:'vertical'
                MDListItem:
                    #theme_bg_color:"Custom"
                    #md_bg_color:49/255, 159/255, 192/255, 1
                    theme_bg_color:"Custom"
                    md_bg_color:49/255, 159/255, 192/255, 1
                    size_hint: 1,None
                    height:dp(30)
                    radius:[20,20,0,0]
                    spacing:dp(10)
                    padding:dp(10)
                    pos_hint: {"y": 0.9}
                    halign:"center"

                    MDListItemLeadingIcon:
                        icon: "currency-usd"


                    MDListItemHeadlineText:

                        text: "somme dans le portefeuille"
                LabelSommePortefeuille:
                    size_hint: 1,None
                    height:dp(70)
                    theme_text_color:"Custom"
                    text_color:0,0,0,0
                    id:labelsommeportefeuille2
                    text:self.somme_portefeuille
        MDCard:
            size_hint_y: None
            height: dp(250)
            style: "elevated"
            elevation: 10
            radius: [20]
            pos_hint: {"y": 0.4}

            MDBoxLayout:
                orientation: "vertical"
                padding: 0
                spacing: dp(15)

                # En-tête du card
                MDListItem:
                    theme_bg_color: "Custom"
                    md_bg_color: 139/255, 139/255, 139/255, 1
                    size_hint_y: None
                    height: dp(60)
                    radius:[20,20,0,0]
                    MDListItemLeadingIcon:
                        icon: "swap-horizontal-bold"

                    MDListItemHeadlineText:
                        text: "effectuer une Transaction"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                # Espaceur pour centrer le contenu
                Widget:
                    size_hint_y: 0.3

                # Champ de saisie
                MDTextField:
                    id: somme_transaction
                    mode: "filled"
                    size_hint: 0.85, None
                    pos_hint: {"center_x": 0.5}

                    MDTextFieldHintText:
                        text: "entrez la somme"

                    MDTextFieldHelperText:
                        text: "ex: 8000"
                        mode: "persistent"

                # Bouton
                MDButton:
                    style: "filled"
                    size_hint: 0.85, None
                    height: dp(45)
                    pos_hint: {"center_x": 0.5}
                    on_press: root.add()

                    MDButtonIcon:
                        icon: "check-underline-circle"

                    MDButtonText:
                        text: "effectuer la transaction"

                # Espaceur en bas
                Widget:
                    size_hint_y: 0.5

